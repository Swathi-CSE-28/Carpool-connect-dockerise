# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/carpool_connect

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
# Access token lifetime (short on purpose: the refresh cookie renews it silently)
JWT_EXPIRES_IN=15m
# How long a login stays alive without signing in again (httpOnly refresh cookie, rotated on every use)
REFRESH_TOKEN_DAYS=30
# Cookie settings. 'lax' works for localhost:5173 -> localhost:5000. If the frontend is on a DIFFERENT site
# (e.g. app.example.com -> api.other.com) use COOKIE_SAMESITE=none, which needs HTTPS.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true          # always on when NODE_ENV=production
# TRUST_PROXY=1               # set when behind a reverse proxy / load balancer so rate limits see real client IPs

# Google OAuth (Google Cloud Console -> OAuth client ID -> Web application)
# Leave blank to disable "Continue with Google" (it fails gracefully with a clear message).
GOOGLE_CLIENT_ID=

# Client
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Live GPS tracking (all optional - sensible defaults are built in)
# ---------------------------------------------------------------------------
# Road routing (OSRM) and place search (Nominatim). The public servers are for light/demo use only;
# point these at your own instances for real traffic. GEO_USER_AGENT should contain your contact email
# (required by the Nominatim usage policy).
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_COUNTRY_CODES=in
GEO_USER_AGENT=CarpoolConnect/1.0 (you@example.com)

# GPS quality filters (metres / m-per-second / ms)
GPS_MAX_ACCEPT_ACCURACY_M=100
GPS_DISTANCE_MAX_ACCURACY_M=50
GPS_MIN_SEGMENT_M=10
GPS_MAX_SPEED_MPS=55
GPS_MIN_UPDATE_INTERVAL_MS=1500

# Retention: location trail is deleted when a ride ends; this TTL is only a backstop
LOCATION_HISTORY_TTL_HOURS=24

# A ride can be started up to this many minutes before its departure time
TRACKING_START_WINDOW_MINUTES=1440
# Auto-pause tracking if a driver sends nothing for this long
TRACKING_ABANDON_MINUTES=360

# Road-route fares (rides created with "Auto" fare mode):
#   price per seat = max(FARE_MIN, round(FARE_BASE + FARE_RATE_PER_KM x road km))
FARE_BASE=10
FARE_RATE_PER_KM=3
FARE_MIN=20

# Distance-billed rides: fare is capped at this multiple of the planned distance
FARE_MAX_ACTUAL_FACTOR=1.25

# JSON array shown by the "Emergency assistance" button (defaults: India 112 / 100 / 108 / 1091)
# EMERGENCY_CONTACTS=[{"label":"Campus Security","number":"0000000000"}]
