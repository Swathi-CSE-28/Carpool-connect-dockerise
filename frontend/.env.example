VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
# Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Map tiles (Leaflet). Defaults to the public OpenStreetMap tile server, which is fine for development
# and light use. For production traffic use a tile provider and set its URL + attribution here.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
